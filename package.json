{
  "name": "diffdojo",
  "version": "0.3.1",
  "description": "A Claude Code plugin that turns waiting time into practice: questions and retro quiz battles about the code Claude just wrote, plus concept quizzes on the topics you work in. Progress stays local; Claude writes questions about each change on your own plan.",
  "license": "MIT",
  "bin": {
    "diffdojo": "bin/diffdojo"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "claude plugin test .",
    "pack-ci": "node scripts/pack-ci.js",
    "lint": "node scripts/check-syntax.js",
    "screenshot": "node --no-warnings scripts/screenshot.mjs"
  },
  "keywords": [
    "claude-code",
    "plugin",
    "learning",
    "code-review",
    "mutation-testing",
    "quiz"
  ],
  "files": [
    ".claude-plugin",
    "hooks",
    "skills",
    "scripts",
    "src",
    "types",
    "bin",
    "packs",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "demo"
  ]
}
